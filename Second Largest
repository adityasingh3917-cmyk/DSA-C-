class Solution {
  public:
    int getSecondLargest(vector<int> &arr) {
        // code here
        int n = arr.size();
        int largest = arr[0];
        int s1 = INT_MIN;
        
        for(int i =0;i<n;i++){
            if(arr[i] > largest){
                largest = arr[i];
            }
        }
        for(int i =0;i<n;i++){
            if(arr[i] > s1 && arr[i] != largest){
                s1 = arr[i];
            }
        }
         if(s1==INT_MIN){
             return -1;
         }
         return s1;
        
    }
};
