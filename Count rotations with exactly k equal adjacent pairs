class Solution {
public:
    int countRotations(string s, int k) {
        int n=s.size();
        if(n==1){
            return(k==0) ? 1:0;
        }
        int total=0;
        for(int i=0;i<n;i++){
            if(s[i] == s[(i+1)%n])
            total++;
        }
        int equalBoundary = total;
        int differentBoundary = n - total;

        if(k==total - 1)
        return equalBoundary;

        if(k==total)
        return differentBoundary;

        return 0;
        
    }
};©leetcode
