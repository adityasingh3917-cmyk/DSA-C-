class Solution {
  public:
    void rotateMatrix(vector<vector<int>>& mat) {
        // code here
        int n=mat.size();
        int i=0;
        while(i != n/2)
        {
            for(int j=0;j<n;j++)
            swap(mat[i][j],mat[n-1-i][j]);
            
            i++;
        }
        for(int i=0;i<n;i++)
        {
            int start=0,end=n-1;
            while(start<end)
            {
                swap(mat[i][start],mat[i][end]);
                start++,end--;
            }
        }
        
    }
};
