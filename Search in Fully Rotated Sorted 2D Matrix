class Solution {
  public:
    bool searchMatrix(vector<vector<int>> &mat, int x) {
        // code here
        int n=mat.size();
        int m=mat[0].size();
        int total=n*m;
        
        int low=0,high=total-1;
        
        while(low<=high){
            int mid=low + (high-low)/2;
            int row=mid/m;
            int col=mid%m;
            int val=mat[row][col];
            
            if(val==x) return true;
            
            int lowVal=mat[low/m][low%m];
            int highVal=mat[high/m][high%m];
            
            if(lowVal<=val){
                if(x>=lowVal && x<val)
                high=mid-1;
                else
                low=mid+1;
            
            }
            else{
                if(x>val && x<=highVal)
                low=mid+1;
                else
                high=mid-1;
            }
        }
        return false;
        
    }
};
