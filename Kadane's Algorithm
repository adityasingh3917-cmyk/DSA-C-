class Solution {
  public:
    int maxSubarraySum(vector<int> &arr) {
        // Code here
        int Maxi = INT_MIN;
        int n=arr.size();
        int Prefix=0;
        for(int i=0;i<n;i++){
            Prefix += arr[i];
            Maxi = max(Maxi,Prefix);
            if(Prefix<0){
                Prefix=0;
            }
        }
        return Maxi;
    }
};
